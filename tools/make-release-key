#!/usr/bin/env bash
# Sets up release signing for Clackatoo: creates the release key if it does not exist yet, then gives it to GitHub
# Actions. Run in an interactive terminal by the maintainer.
#
#   tools/make-release-key
#
# - Without a key: asks for a new password and creates ~/.config/clackatoo/release.p12 (CLACKATOO_KEY_DIR overrides
#   the folder).
# - With a key: asks for its password and reuses it. A run that failed after creating the key is finished by running
#   this again; an existing key is never replaced.
# - Stores the key and password as the repository secrets CLACKATOO_KEYSTORE_BASE64 and CLACKATOO_KEYSTORE_PASSWORD,
#   and the certificate's SHA-256 as the variable RELEASE_CERT_SHA256 (the release workflow refuses any other key).
#   Refuses to upload a key whose certificate differs from an RELEASE_CERT_SHA256 that is already set.
# - Prints the certificate SHA-256, the value AppVerifier checks.
#
# The key file and its password must be backed up outside the repository. Without them no update can be signed, and
# installed copies would have to be uninstalled (losing settings and learned words) to move to a new key.
# Requires a JDK (keytool) and gh signed in as highlyproteus.
set -euo pipefail

repo=highlyproteus/clackatoo
dir=${CLACKATOO_KEY_DIR:-$HOME/.config/clackatoo}
ks=$dir/release.p12

[[ -t 0 ]] || { echo "Run this in an interactive terminal." >&2; exit 1; }

if [[ -n ${JAVA_HOME:-} && -x $JAVA_HOME/bin/keytool ]]; then
  keytool=$JAVA_HOME/bin/keytool
elif [[ -x /usr/libexec/java_home ]] && home=$(/usr/libexec/java_home 2>/dev/null); then
  keytool=$home/bin/keytool
elif command -v keytool >/dev/null && keytool -help >/dev/null 2>&1; then
  keytool=$(command -v keytool)
else
  echo "No JDK found (keytool). Install one (for example Temurin 21) and run this again." >&2
  exit 1
fi

GH_TOKEN=$(gh auth token --user highlyproteus) || { echo "gh is not signed in as highlyproteus." >&2; exit 1; }
export GH_TOKEN
gh repo view "$repo" --json name >/dev/null

if [[ -e $ks ]]; then
  echo "Using the existing key $ks."
  read -rsp "Password of the release key: " CLACKATOO_KEY_PASSWORD; echo
  export CLACKATOO_KEY_PASSWORD
else
  read -rsp "Choose a password for the release key (at least 12 characters): " pw; echo
  read -rsp "Type it again: " pw2; echo
  [[ $pw == "$pw2" ]] || { echo "The passwords differ." >&2; exit 1; }
  (( ${#pw} >= 12 )) || { echo "Use at least 12 characters." >&2; exit 1; }
  export CLACKATOO_KEY_PASSWORD=$pw
  unset pw pw2

  mkdir -p "$dir"
  chmod 700 "$dir"
  (
    umask 077
    "$keytool" -genkeypair -keystore "$ks" -storetype PKCS12 -storepass:env CLACKATOO_KEY_PASSWORD \
      -alias clackatoo -keyalg RSA -keysize 4096 -validity 10000 -dname "CN=Clackatoo" >/dev/null
  )
  echo "Created $ks."
fi

# Also proves that the password opens the key, so a wrong password is never uploaded.
cert=$("$keytool" -list -v -keystore "$ks" -storetype PKCS12 -storepass:env CLACKATOO_KEY_PASSWORD -alias clackatoo \
  2>/dev/null | sed -n 's/^[[:space:]]*SHA256: //p') || true
[[ $cert =~ ^([0-9A-F]{2}:){31}[0-9A-F]{2}$ ]] ||
  { echo "Could not open $ks with that password (or read its certificate)." >&2; exit 1; }

# `variable list` succeeds with no entry when the pin is absent; any failure (network, auth, server) stops here, so an
# unreadable pin is never mistaken for a missing one.
current=$(gh variable list --repo "$repo" --json name,value \
  --jq '.[] | select(.name == "RELEASE_CERT_SHA256") | .value') ||
  { echo "Could not read the repository variables from GitHub. Nothing was uploaded." >&2; exit 1; }
if [[ -n $current && $current != "$cert" ]]; then
  cat >&2 <<EOF
GitHub already expects a different release certificate:
  set on GitHub: $current
  this key:      $cert
Nothing was uploaded. Releases must stay signed with the key GitHub expects.
EOF
  exit 1
fi

base64 <"$ks" | tr -d '\n' | gh secret set CLACKATOO_KEYSTORE_BASE64 --repo "$repo"
printf '%s' "$CLACKATOO_KEY_PASSWORD" | gh secret set CLACKATOO_KEYSTORE_PASSWORD --repo "$repo"
gh variable set RELEASE_CERT_SHA256 --repo "$repo" --body "$cert"

cat <<EOF

GitHub Actions can now sign releases.

Key:         $ks
Certificate: $cert

Back up the key file and its password outside the repository.
EOF
