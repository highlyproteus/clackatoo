<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- toolbar key names: the resource name is the lowercase ToolbarKey name -->
    <string name="escape" tools:keep="@string/escape">Esc</string>
    <string name="tab" tools:keep="@string/tab">Tab</string>
    <string name="ctrl" tools:keep="@string/ctrl">Ctrl</string>
    <string name="alt" tools:keep="@string/alt" tools:ignore="MissingTranslation">Alt</string>
    <!-- Settings > Terminal -->
    <string name="settings_screen_terminal" tools:ignore="MissingTranslation">Terminal</string>
    <string name="terminal_keys">Terminal keys</string>
    <string name="terminal_keys_summary" tools:ignore="MissingTranslation">In terminal and SSH apps, show Esc, Tab, Ctrl, Alt and arrow keys above the keyboard. Tap Ctrl or Alt, then a key, for Ctrl+C and the like. Nothing is suggested or corrected while they show.</string>
    <string name="terminal_bottom_row" tools:ignore="MissingTranslation">Slash and dash keys</string>
    <string name="terminal_bottom_row_summary" tools:ignore="MissingTranslation">In terminals, / and - take the place of the comma and emoji keys. Hold them for | ~ ` and _ = +, and hold . for the comma.</string>
    <string name="terminal_swipe" tools:ignore="MissingTranslation">Swipe typing in terminals</string>
    <string name="terminal_swipe_summary" tools:ignore="MissingTranslation">Off: sliding over the keys never types a word in a terminal.</string>
</resources>
