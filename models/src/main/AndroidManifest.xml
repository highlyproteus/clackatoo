<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exactly these permissions; the release workflow fails if the APK asks for any other. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- the Clackatoo signature permission, declared by both apps: only apps signed with the Clackatoo key can talk to each other -->
    <permission android:name="${modelsPermission}" android:protectionLevel="signature" />
    <uses-permission android:name="${modelsPermission}" />

    <queries>
        <package android:name="${keyboardApplicationId}" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClackatooModels">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          "Browse Hugging Face": the user's own choice of a custom model. Not exported, so no other app (the keyboard
          included) can open it. It handles rotation itself so that the list and the search stay.
        -->
        <activity android:name=".BrowseActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />

        <!--
          The keyboard binds this service and asks for a download (a catalog id and nothing else) with a Binder call;
          DownloadBinder checks the caller's package and signature on every call, and the signature permission keeps every
          other app from binding at all. Start intents only make it a foreground service and carry nothing it reads.
        -->
        <service android:name=".DownloadService"
            android:exported="true"
            android:permission="${modelsPermission}"
            android:foregroundServiceType="dataSync" />

        <!-- the Cancel button of the download notification (own PendingIntent only) -->
        <receiver android:name=".CancelReceiver" android:exported="false" />
    </application>
</manifest>
