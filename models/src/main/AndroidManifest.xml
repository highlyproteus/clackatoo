<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exactly these permissions; the release workflow fails if the APK asks for any other. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- the Clackatoo signature permission, declared by both apps: only apps signed with the Clackatoo key can talk to each other -->
    <permission android:name="${modelsPermission}" android:protectionLevel="signature" />
    <uses-permission android:name="${modelsPermission}" />

    <queries>
        <package android:name="${keyboardApplicationId}" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClackatooModels">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Starts a download of one catalog model. The Intent carries the model id and nothing else (RequestParser refuses
          unknown ids and any other extra, URL or data); the signature permission keeps every other app out.
        -->
        <service android:name=".DownloadService"
            android:exported="true"
            android:permission="${modelsPermission}"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
